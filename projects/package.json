{
    "name": "neonflux-workspace",
    "private": true,
    "packageManager": "pnpm@12.9.1",
    "scripts": {
        "build": "pnpm --filter @neonflux/bot run build",
        "check": "pnpm --filter @neonflux/contracts run check && pnpm --filter @neonflux/backend run check && pnpm --filter @neonflux/bot run check",
        "dev:bot": "pnpm --filter @neonflux/bot run dev",
        "deploy:dev": "pnpm --filter @neonflux/backend run deploy:dev",
        "start": "pnpm --filter @neonflux/bot run start"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
