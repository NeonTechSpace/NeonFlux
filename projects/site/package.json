{
    "name": "@neonflux/site",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
        "dev": "astro dev --host localhost --port 4321",
        "build": "node ../scripts/heavy.mjs --shell \"astro build && pagefind --site dist\"",
        "preview": "astro preview --host localhost --port 4321",
        "test": "node ../scripts/heavy.mjs node --test tests/*.test.mjs",
        "check": "pnpm run build && pnpm run test"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "7.3.5",
        "astro": "7.4.4"
    },
    "devDependencies": {
        "pagefind": "1.6.0"
    }
}
