# Same key names are used for local and deployed runs; only the values change.

# Core runtime
# App runtime for direct local commands. Docker Compose hardcodes production for app containers.
APP_ENV=development

# Node/runtime environment for direct local commands. Docker Compose hardcodes production for app containers.
NODE_ENV=development

# Logging verbosity.
LOG_LEVEL=info

# Deployment mode and authorization
# Public browser-facing origin. Bot writes this into deployment_config; app code owns paths.
# Example: https://neonflux.example
PUBLIC_WEB_URL=

# Bot bootstrap mode. Bot writes this into deployment_config; web reads the DB row.
INSTANCE_MODE=multi

# Required only when INSTANCE_MODE=single. Bot writes this into deployment_config; web reads the DB row.
SINGLE_GUILD_ID=

# Comma-separated Fluxer user ids. Bot writes these into deployment_config; web reads the DB row.
OWNER_IDS=

# Guild safety override checked before DB policy.
# auto: dev is DEFCON 2 by default, prod uses DB/default DEFCON 3.
# Use 3 locally when you intentionally want to unlock dev.
# 1: emergency owner-only command/dashboard mode.
# 2: public commands work, guarded commands/dashboard settings are owner-only.
# 3: normal mode.
GUILD_DEFCON_OVERRIDE=auto

# Convex runtime target.
# CONVEX_URL is the server-side Convex deployment URL used by web/bot service clients.
# VITE_CONVEX_URL is the browser-safe Convex deployment URL used by dashboard live subscriptions.
# `npx convex dev` may also write these into .env.local for the Convex CLI; keep .env populated for NeonFlux app runtime.
# Leave blank until a Convex deployment is selected for this environment.
CONVEX_URL=
VITE_CONVEX_URL=

# Used by Convex deploy/codegen workflows.
# CONVEX_DEPLOYMENT is safe as deployment metadata.
# CONVEX_DEPLOY_KEY is a secret for deploy automation. Do not expose deploy keys to browsers.
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# NeonFlux-issued JWTs for Convex custom auth.
# These are for Convex auth only. They are not Fluxer OAuth settings.
# NEONFLUX_AUTH_JWT_ISSUER is the stable iss claim for NeonFlux-issued Convex JWTs.
# It is not the Fluxer OAuth host. It does not need to be publicly fetchable when NEONFLUX_AUTH_JWT_JWKS is set.
# Example production value: https://neonflux.example/auth
# NEONFLUX_AUTH_JWT_AUDIENCE must match Convex auth.config.ts applicationID and the Convex deployment env var.
# NEONFLUX_AUTH_JWT_JWKS is public key material for Convex auth. Prefer a data:application/json,... JWKS URI for local dev and deploys.
# Generate from the server-only private key with: pnpm --silent generate:convex-jwks
# Dry-run Convex env setup with: pnpm convex:configure-auth-env -- --issuer <stable-NeonFlux-issuer> --deployment <target>
# NEONFLUX_AUTH_JWT_PRIVATE_KEY is the server-only RS256 PKCS8 private key used by web/bot to sign user/service JWTs.
# Store multiline PEMs in .env as escaped newlines, for example -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----.
# Convex should receive issuer/audience/public JWKS only; Convex must not receive this private key.
NEONFLUX_AUTH_JWT_ISSUER=
NEONFLUX_AUTH_JWT_AUDIENCE=neonflux-convex
NEONFLUX_AUTH_JWT_JWKS=
NEONFLUX_AUTH_JWT_PRIVATE_KEY=

# Fluxer application and OAuth
# Fluxer application id for OAuth web login.
FLUXER_APP_ID=

# OAuth callback URL registered in the Fluxer application.
# Local dev usually uses localhost. Production should use the public HTTPS web URL.
FLUXER_OAUTH_REDIRECT_URL=http://localhost:3000/auth/fluxer/callback

# Optional bot invite URL shown as the + action in authenticated dashboard guild navigation.
FLUXER_BOT_INVITE_URL=

# Fluxer OAuth client secret. Server-side only.
FLUXER_CLIENT_SECRET=

# Separate key used to encrypt stored Fluxer OAuth tokens. Generate with: pnpm generate:token-encryption-key
FLUXER_TOKEN_ENCRYPTION_KEY=

# Bot runtime
# Fluxer bot token. Server-side only.
FLUXER_BOT_TOKEN=

# Optional bot custom status text. Leave blank for no custom status.
FLUXER_BOT_CUSTOM_STATUS=

# Web sessions
# Secret used to sign web sessions. Generate with: pnpm generate:session-secret
SESSION_SECRET=

# Docker Compose
# Docker image tags used by docker-compose.yml.
NEONFLUX_BOT_IMAGE_TAG=latest
NEONFLUX_WEB_IMAGE_TAG=latest

# Host port for the web service in Docker Compose.
WEB_PORT=3000

# Optional self-hosted Convex stack
# Used by docker-compose.convex.yml. Leave unset when using a hosted Convex deployment.
# Use latest only for local tests; pin production.
CONVEX_REV=latest

# One Convex instance per project/environment. The database name is INSTANCE_NAME with "-" replaced by "_".
CONVEX_INSTANCE_NAME=neonflux-prod
CONVEX_POSTGRES_DB=neonflux_prod
CONVEX_INSTANCE_SECRET=

# Dedicated Convex Postgres. Do not reuse the NeonFlux app database.
CONVEX_POSTGRES_USER=convex
CONVEX_POSTGRES_PASSWORD=

# Browser-facing Convex URLs behind the reverse proxy.
CONVEX_CLOUD_ORIGIN=https://convex-api.example.com
CONVEX_SITE_ORIGIN=https://convex-site.example.com
NEXT_PUBLIC_DEPLOYMENT_URL=https://convex-api.example.com

# Local Docker Postgres is not TLS.
CONVEX_DO_NOT_REQUIRE_SSL=1
CONVEX_RUST_LOG=info

# Optional direct ports for the Convex compose file.
CONVEX_PORT=3210
CONVEX_SITE_PROXY_PORT=3211
CONVEX_DASHBOARD_PORT=6791
