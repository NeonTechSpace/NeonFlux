{
    "name": "@neonflux/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        },
        "./convex": {
            "types": "./src/convex.ts",
            "import": "./dist/convex.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@neonflux/config": "workspace:*",
        "@neonflux/convex": "workspace:*",
        "@neonflux/core": "workspace:*",
        "neverthrow": "^8.2.0"
    }
}
