FLUXER_BOT_TOKEN=
NEONFLUX_CUSTOM_STATUS=

# Convex deployment URL, such as https://your-deployment.convex.cloud, and the
# bot's dedicated backend secret, the same text as in the Convex deployment
# without surrounding spaces. The bot sends only a key derived from the secret.
# It adopts the server scope and the website origin from the deployment
CONVEX_URL=
NEONFLUX_BOT_API_SECRET=

# Optional check of the deployment's scope. Set either to refuse a start against
# a deployment that serves another server or mode. Without a backend, the bot
# serves the one server NEONFLUX_SERVER_ID names
# NEONFLUX_SERVER_ID=<SERVER_ID>
# NEONFLUX_SERVER_MODE=multi

# Optional independent recovery key, exact base64 32 bytes
# Leave absent to disable backup crypto while other features continue
# NEONFLUX_BACKUP_KEY=<BASE64_32_BYTE_RECOVERY_KEY>
