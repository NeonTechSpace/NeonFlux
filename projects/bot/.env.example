FLUXER_BOT_TOKEN=
NEONFLUX_CUSTOM_STATUS=

# Convex HTTP Actions URL and the bot's dedicated backend credential, the same
# text as in the Convex deployment without surrounding spaces. The bot adopts
# the server scope from the deployment
CONVEX_SITE_URL=
NEONFLUX_BOT_API_SECRET=

# Optional check of the deployment's scope. Set any of these to refuse a start
# against a deployment that serves other servers or another mode. Without a
# backend, the bot serves the one server NEONFLUX_SERVER_ID names
# NEONFLUX_SERVER_ID=<SERVER_ID>
# NEONFLUX_SERVER_MODE=multi
# NEONFLUX_SERVER_IDS=["<SERVER_ID_A>","<SERVER_ID_B>"]

# Optional independent recovery key, exact base64 32 bytes
# Leave absent to disable backup crypto while other features continue
# NEONFLUX_BACKUP_KEY=<BASE64_32_BYTE_RECOVERY_KEY>
