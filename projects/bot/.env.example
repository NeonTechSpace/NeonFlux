FLUXER_BOT_TOKEN=
NEONFLUX_SERVER_ID=
# Single mode is the default. For multi mode, remove NEONFLUX_SERVER_ID, set
# multi mode in the backend too, and restart. The bot registers every server
# it joins through the backend, so multi mode has no server list
# NEONFLUX_SERVER_MODE=multi
NEONFLUX_CUSTOM_STATUS=

# Optional reachable website origin for advanced verification links
# Loopback HTTP is permitted only for local testing
NEONFLUX_WEBSITE_URL=

# Convex HTTP Actions URL and the bot's dedicated backend credential
# Multi mode requires both
CONVEX_SITE_URL=
NEONFLUX_BOT_API_SECRET=

# Optional independent recovery key, exact base64 32 bytes
# Leave absent to disable backup crypto while other features continue
# NEONFLUX_BACKUP_KEY=<BASE64_32_BYTE_RECOVERY_KEY>
