{
    "name": "@neonflux/bot",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
        "build": "node ../scripts/heavy.mjs tsc --project tsconfig.json --singleThreaded",
        "typecheck": "node ../scripts/heavy.mjs node ../scripts/effect-tsc.mjs --project tsconfig.test.json --singleThreaded",
        "test": "pnpm run build && node ../scripts/heavy.mjs node --test --test-concurrency=1 tests/*.test.ts",
        "check": "pnpm run typecheck && pnpm run test",
        "dev": "node --env-file-if-exists=.env --watch src/main.ts",
        "start": "node --env-file-if-exists=.env dist/main.js",
        "smoke:live": "node --env-file-if-exists=.env scripts/smoke-live.ts"
    },
    "devDependencies": {
        "@types/node": "24.19.1",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@neonflux/contracts": "workspace:*",
        "@neontechspace/fluxerly": "1000.0.0-nightly.20261030.37",
        "convex": "catalog:",
        "effect": "catalog:"
    }
}
