# Deployment-specific development key from the Convex dashboard
CONVEX_DEPLOY_KEY=

# Provision these values separately in the Convex deployment environment
# Omitted mode preserves single-server operation
NEONFLUX_SERVER_MODE=single
NEONFLUX_SERVER_ID=
# For multi mode, remove NEONFLUX_SERVER_ID and set a strict JSON array of
# one to ten distinct canonical decimal server strings, for example ["10","20"]
# NEONFLUX_SERVER_IDS=
NEONFLUX_BOT_API_SECRET=
# Required for advanced verification. Provision in the Convex environment
TURNSTILE_SECRET_KEY=
# Exact website hostnames, without schemes, ports or paths
# Production must exclude localhost and 127.0.0.1
TURNSTILE_HOSTNAMES=localhost
