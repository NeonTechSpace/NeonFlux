# Deployment-specific development key from the Convex dashboard
CONVEX_DEPLOY_KEY=

# Provision these values separately in the Convex deployment environment
# Omitted mode preserves single-server operation
NEONFLUX_SERVER_MODE=single
NEONFLUX_SERVER_ID=
# For multi mode, set NEONFLUX_SERVER_MODE=multi and remove NEONFLUX_SERVER_ID.
# The bot registers the servers it joins, so multi mode has no server list
NEONFLUX_BOT_API_SECRET=
# Fluxer OAuth application ID that dashboard sign-in tokens must belong to
FLUXER_CLIENT_ID=
# Required for advanced verification. Provision in the Convex environment
TURNSTILE_SECRET_KEY=
# Exact website hostnames, without schemes, ports or paths
# Production must exclude localhost and 127.0.0.1
TURNSTILE_HOSTNAMES=localhost
# Optional bill guard, provisioned in the Convex environment. The budget is a
# whole number of billed function calls per UTC month. Absent turns it off.
# The bot warns at the warning share, default 0.65, and pauses optional work at 0.9
# NEONFLUX_MONTHLY_CALL_BUDGET=<CALLS_PER_MONTH>
# NEONFLUX_BUDGET_WARNING_SHARE=0.65
# Optional YouTube upload alerts, provisioned in the Convex environment. Both are
# HTTPS addresses without credentials, query or fragment. The hub is where NeonFlux
# subscribes, and the callback base is this deployment's .convex.site origin or a
# custom domain that YouTube's hub calls back. Absent turns YouTube alerts off
# NEONFLUX_WEBSUB_HUB_URL=https://pubsubhubbub.appspot.com/subscribe
# NEONFLUX_WEBSUB_CALLBACK_BASE=https://<deployment>.convex.site
