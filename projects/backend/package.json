{
    "name": "@neonflux/backend",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "exports": {
        "./dashboard-contracts": {
            "types": "./dashboard-contracts.d.ts"
        }
    },
    "scripts": {
        "codegen": "node ../scripts/heavy.mjs convex codegen",
        "typecheck": "node ../scripts/heavy.mjs node ../scripts/effect-tsc.mjs --project tsconfig.json --singleThreaded",
        "test": "node ../scripts/heavy.mjs node --test --test-concurrency=1 tests/*.test.ts",
        "check": "pnpm run typecheck && pnpm run test",
        "dev": "convex dev",
        "deploy:dev": "convex dev --once --typecheck disable"
    },
    "dependencies": {
        "@neonflux/contracts": "workspace:*",
        "convex": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "24.19.1",
        "convex-test": "0.0.60",
        "typescript": "catalog:"
    }
}
