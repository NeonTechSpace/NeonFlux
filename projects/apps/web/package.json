{
    "name": "neonflux-web",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "vite dev --port 3000",
        "generate-routes": "tsr generate",
        "build": "vite build && node ../../scripts/check-dashboard-bundle-boundaries.mjs --assets .output/public/assets",
        "start": "node ../../scripts/start-web.mjs",
        "preview": "vite preview",
        "e2e:public": "playwright test --config playwright.config.ts",
        "e2e:guards": "vitest --root ../.. run apps/web/e2e/support/authenticated-orchestration.test.ts apps/web/e2e/support/ephemeral-state.test.ts",
        "e2e:authenticated": "tsx e2e/support/run-authenticated-journeys.ts",
        "e2e:authenticated:composition": "tsx e2e/support/run-authenticated-composition.ts",
        "e2e:authenticated:browser": "tsx e2e/support/run-authenticated-browser.ts",
        "e2e:serve": "node e2e/support/start-built-web.mjs",
        "e2e:convex:start": "tsx e2e/support/ephemeral-convex.ts start",
        "e2e:convex:stop": "tsx e2e/support/ephemeral-convex.ts stop",
        "e2e:convex:status": "tsx e2e/support/ephemeral-convex.ts status",
        "test": "vitest run",
        "typecheck": "fumadocs-mdx && tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck"
    },
    "dependencies": {
        "@fontsource/outfit": "^5.2.8",
        "@fontsource/roboto-mono": "^5.2.9",
        "@neonflux/blueprint": "workspace:*",
        "@neonflux/config": "workspace:*",
        "@neonflux/convex": "workspace:*",
        "@neonflux/convex-api": "workspace:*",
        "@neonflux/core": "workspace:*",
        "@neonflux/db": "workspace:*",
        "@neonflux/fluxer": "workspace:*",
        "@neonflux/messaging": "workspace:*",
        "@pierre/diffs": "^1.2.12",
        "@pierre/trees": "1.0.0-beta.5",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-devtools": "0.10.7",
        "@tanstack/react-form": "^1.33.1",
        "@tanstack/react-query": "5.101.0",
        "@tanstack/react-router": "1.170.16",
        "@tanstack/react-router-devtools": "1.167.0",
        "@tanstack/react-start": "1.168.26",
        "@tanstack/react-virtual": "^3.14.3",
        "@tsparticles/engine": "^4.3.0",
        "@tsparticles/react": "^4.3.0",
        "@tsparticles/slim": "^4.3.0",
        "@types/mdx": "^2.0.14",
        "arktype": "^2.2.0",
        "convex": "^1.30.0",
        "fumadocs-core": "^16.10.5",
        "fumadocs-mdx": "^15.0.12",
        "fumadocs-ui": "^16.10.5",
        "lucide-react": "^0.545.0",
        "motion": "^12.42.2",
        "mutative": "^1.3.0",
        "neverthrow": "^8.2.0",
        "nitro": "^3.0.260610-beta",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "recharts": "^3.9.0",
        "tailwindcss": "^4.1.18",
        "tslib": "^2.8.1",
        "zustand": "^5.0.14",
        "zustand-mutative": "^1.3.1"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@eslint-react/eslint-plugin": "^5.9.0",
        "@ninoseki/eslint-plugin-neverthrow": "0.2.0",
        "@playwright/test": "^1.61.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tanstack/devtools-vite": "0.8.0",
        "@tanstack/eslint-config": "0.4.0",
        "@tanstack/eslint-plugin-query": "5.101.0",
        "@tanstack/eslint-plugin-router": "1.162.0",
        "@tanstack/router-cli": "1.167.17",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.0",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/eslint-plugin": "^1.6.20",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y-x": "^0.2.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-testing-library": "^7.16.2",
        "jsdom": "^28.1.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.0",
        "vitest": "^4.1.5"
    }
}
