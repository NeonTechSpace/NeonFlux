{
  "name": "@neonflux/web",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host localhost --port 3000 --strictPort",
    "build": "node ../scripts/heavy.mjs vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "node ../scripts/heavy.mjs tsc --project tsconfig.json --singleThreaded",
    "test": "node ../scripts/heavy.mjs tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@neonflux/backend": "workspace:*",
    "@neonflux/contracts": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "convex": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.2",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
