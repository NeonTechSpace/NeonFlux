# Website server only. Never use a VITE_ prefix for private configuration
WEB_ORIGIN=http://localhost:3000
FLUXER_CLIENT_ID=
FLUXER_CLIENT_SECRET=
CONVEX_URL=
# Generate at least 32 random bytes. Used to authenticate the short-lived OAuth handshake
WEB_SESSION_SECRET=
# Public widget site key. The secret is validated in the Convex backend
TURNSTILE_SITE_KEY=
# Provision the matching secret and deployment-specific hostnames in Convex
# TURNSTILE_SECRET_KEY and TURNSTILE_HOSTNAMES are required for verification starts
