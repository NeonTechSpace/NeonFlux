# Website server only. Never use a VITE_ prefix for private configuration
# The Convex deployment owns the website origin and the Fluxer OAuth application
# ID, so the web server reads both from it and keeps only these values
CONVEX_URL=
# The secret of the Fluxer OAuth application the deployment's FLUXER_CLIENT_ID names
FLUXER_CLIENT_SECRET=
# Generate at least 32 random bytes. Used to authenticate the short-lived OAuth handshake
WEB_SESSION_SECRET=
# Public widget site key. The secret is validated in the Convex backend
TURNSTILE_SITE_KEY=
